# claude-mem server-beta — 예시 설정. .env로 복사한 뒤 값을 채운다 (.env는 gitignore됨).
# Subscription generation (no per-token API cost):
CLAUDE_MEM_SERVER_PROVIDER=openrouter
# Open-source LLM via local Ollama (OpenAI-compatible). Switch back to
# subscription by changing the line above to: CLAUDE_MEM_SERVER_PROVIDER=subscription
CLAUDE_MEM_OPENROUTER_BASE_URL=http://host.docker.internal:11434/v1
CLAUDE_MEM_SERVER_MODEL=llama3.1:8b
OPENROUTER_API_KEY=ollama
# CLAUDE_CODE_OAUTH_TOKEN (for subscription-mode generation) is a live secret —
# keep its real value OUT of git. Put it in .env.local (gitignored), not here.
# This tracked file carries only a placeholder.
CLAUDE_CODE_OAUTH_TOKEN=set-in-.env.local

# Postgres creds (recovered from the running stack) — read by docker-compose.my.yml ${VAR:?required}
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claudemem
# Full DB URL with the password URL-encoded (@ -> %40). The server-beta URL parser
# is strict: an unencoded '@' in the password mangles the host (getaddrinfo fails).
CLAUDE_MEM_SERVER_DATABASE_URL=postgres://admin:change-me@postgres:5432/claudemem

# 셀프 enroll join secret은 .env.local에 둔다 (docs/server.md 참고):
# CLAUDE_MEM_SERVER_ENROLL_SECRET=
